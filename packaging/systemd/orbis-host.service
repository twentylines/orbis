[Unit]
Description=Orbis restricted host update service
Documentation=https://github.com/twentylines/orbis/blob/main/HOST-SERVICE.md
Wants=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/orbis/host-service.env
RuntimeDirectory=orbis
RuntimeDirectoryMode=0700
StateDirectory=orbis
StateDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0700 /var/lib/orbis/state /var/lib/orbis/snapshots
ExecStart=/usr/bin/python3 ${ORBIS_SERVICE_SOURCE} --root ${ORBIS_ROOT} --docker-context ${ORBIS_DOCKER_CONTEXT} --socket /run/orbis/host.sock --snapshots /var/lib/orbis/snapshots --state-dir /var/lib/orbis/state
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=20s
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
