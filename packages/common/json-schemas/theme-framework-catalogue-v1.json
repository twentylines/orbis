{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "const": "orbis.theme-framework-catalogue.v1"
    },
    "themes": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "properties": {
          "author": {
            "type": "string",
            "pattern": "^[^<>\\u0000-\\u001f\\u007f-\\u009f\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$",
            "maxLength": 160,
            "minLength": 1
          },
          "description": {
            "type": "string",
            "pattern": "^[^<>\\u0000-\\u001f\\u007f-\\u009f\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$",
            "maxLength": 160,
            "minLength": 1
          },
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
            "maxLength": 64
          },
          "name": {
            "type": "string",
            "pattern": "^[^<>\\u0000-\\u001f\\u007f-\\u009f\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$",
            "maxLength": 160,
            "minLength": 1
          },
          "package": {
            "type": "object",
            "properties": {
              "bytes": {
                "type": "integer",
                "maximum": 33554432,
                "minimum": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "url": {
                "type": "string",
                "maxLength": 512
              }
            },
            "required": ["bytes", "sha256", "url"],
            "additionalProperties": false
          },
          "repository": {
            "type": "string",
            "maxLength": 256
          },
          "requires": {
            "type": "object",
            "properties": {
              "api": {
                "const": 1
              },
              "releases": {
                "type": "array",
                "maxItems": 32,
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^v?(0|[1-9]\\d{0,8})\\.(0|[1-9]\\d{0,8})\\.(0|[1-9]\\d{0,8})(?:-(beta|rc)\\.(0|[1-9]\\d{0,8}))?$",
                  "maxLength": 80
                }
              }
            },
            "required": ["api", "releases"],
            "additionalProperties": false
          },
          "supportsUiRevisions": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "integer",
              "maximum": 9007199254740991,
              "minimum": 1
            }
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9]\\d{0,8})\\.(0|[1-9]\\d{0,8})\\.(0|[1-9]\\d{0,8})$",
            "maxLength": 32
          }
        },
        "required": ["author", "description", "id", "name", "package", "repository", "requires", "supportsUiRevisions", "version"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schema", "themes"],
  "additionalProperties": false,
  "$id": "urn:orbis:theme-framework-catalogue:v1",
  "$comment": "Structural constraints only. validateThemeFrameworkCatalogue also enforces reserved identities, repository and package URL binding, and unique versions and requirements. Catalogue metadata does not enable theme installation."
}
